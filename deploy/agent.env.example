# Copy into root-owned /etc/trace-hunter/agent.env; never commit the filled file.
TRACE_HUNTER_AGENT_API_URL=http://127.0.0.1:8767
TRACE_HUNTER_AGENT_WORK_DIR=/var/lib/trace-hunter-agent/work
TRACE_HUNTER_CLAUDE_BIN=/opt/trace-hunter-claude-2.1.274/node_modules/@anthropic-ai/claude-code-linux-x64/claude
TRACE_HUNTER_AGENT_TURN_TIMEOUT=1200
TRACE_HUNTER_AGENT_WORKER_TOKEN=REPLACE_WITH_RANDOM_PRIVATE_VALUE
ANTHROPIC_BASE_URL=https://super-relay.byted.org
ANTHROPIC_AUTH_TOKEN=REPLACE_WITH_ROTATED_PRIVATE_VALUE
ANTHROPIC_MODEL=model_api/experimental_0723
ANTHROPIC_DEFAULT_OPUS_MODEL=model_api/experimental_0723
ANTHROPIC_DEFAULT_SONNET_MODEL=model_api/experimental_0723
ANTHROPIC_DEFAULT_HAIKU_MODEL=model_api/experimental_0723
CLAUDE_CODE_SUBAGENT_MODEL=model_api/experimental_0723
CLAUDE_CODE_ATTRIBUTION_HEADER=0
