# Copy to var/containers/deployment.env; combine with images.env in the commands below.
TRACE_HUNTER_VERSION=local
WEB_BIND=127.0.0.1
WEB_PORT=8766
PUBLIC_ORIGIN=http://127.0.0.1:8766
# Absolute paths; private parent directory mode 0700. Files must be readable by
# container users (mode 0644 under that private directory works with local Compose).
DB_PASSWORD_FILE=/absolute/private/secrets/db_password
WEB_AUTH_FILE=/absolute/private/secrets/access.caddy
