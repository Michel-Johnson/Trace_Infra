diff --git a/server/routes/trace-hunter-import-routes.ts b/server/routes/trace-hunter-import-routes.ts
new file mode 100644
index 00000000..80c55289
--- /dev/null
+++ b/server/routes/trace-hunter-import-routes.ts
@@ -0,0 +1,232 @@
+// Private worker-to-terminal bridge. This starts the SAME Claude PTY that the browser attaches to;
+// it never renders stream-json as terminal output or accepts browser-authored job metadata.
+import { createHash, timingSafeEqual } from "node:crypto";
+import express, { type Express, type Request } from "express";
+import fs from "node:fs";
+import path from "node:path";
+import { CLAUDE_CWD, SESSION_ID_RE } from "../config/env.js";
+import { projectSessionsDir } from "../session/project-dir.js";
+import { ptys } from "../session/registry.js";
+import { tmuxHasSession } from "../infra/tmux.js";
+import type { createClaudeSpawner } from "../session/spawn-claude.js";
+
+const root = path.join(CLAUDE_CWD, ".trace-hunter-imports");
+const base = "/api/internal/trace-hunter/imports";
+const maxUpload = 268_435_456;
+const hashOf = (bytes: Buffer | string): string => createHash("sha256").update(bytes).digest("hex");
+const dirOf = (id: string): string => path.join(root, id);
+
+function privateRequest(req: Request): boolean {
+  const expected = process.env.TRACE_HUNTER_IMPORT_BRIDGE_TOKEN;
+  const supplied = req.get("X-Trace-Hunter-Import-Token") || "";
+  if (!expected || expected.length < 32 || expected.length !== supplied.length) return false;
+  const address = req.socket.remoteAddress;
+  return (address === "127.0.0.1" || address === "::1" || address === "::ffff:127.0.0.1") &&
+    timingSafeEqual(Buffer.from(expected), Buffer.from(supplied));
+}
+
+function filename(raw: string): string {
+  const name = path.basename(raw).replace(/[\r\n\0]/g, "").slice(0, 180);
+  return name && name !== "." && name !== ".." ? name : "trace.json";
+}
+
+function prepareJob(id: string): string {
+  const dir = dirOf(id);
+  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
+  for (const relative of ["CLAUDE.md", ".mulmoterminal.json", ".claude/skills", "scripts", "contracts/schemas"]) {
+    const source = path.join(CLAUDE_CWD, relative);
+    const target = path.join(dir, relative);
+    if (fs.existsSync(source) && !fs.existsSync(target)) {
+      fs.mkdirSync(path.dirname(target), { recursive: true, mode: 0o700 });
+      fs.cpSync(source, target, { recursive: true, force: false });
+    }
+  }
+  return dir;
+}
+
+function stopped(dir: string): boolean {
+  const file = path.join(dir, "hook.jsonl");
+  if (!fs.existsSync(file)) return false;
+  // Inspect only a bounded tail; an interactive session can accumulate many subsequent turns.
+  const size = fs.statSync(file).size;
+  const length = Math.min(size, 16 * 1024 * 1024);
+  const bytes = Buffer.alloc(length);
+  const handle = fs.openSync(file, "r");
+  try { fs.readSync(handle, bytes, 0, length, size - length); }
+  finally { fs.closeSync(handle); }
+  return bytes.toString("utf8").split("\n").some(line => {
+    if (!line) return false;
+    try { return ["Stop", "StopFailure"].includes(JSON.parse(line)?.value?.hook_event_name); }
+    catch { return false; }
+  });
+}
+
+function sessionEvidence(id: string, dir: string): { live: boolean; transcript: boolean } {
+  return {
+    live: ptys.has(id) || tmuxHasSession(id),
+    transcript: fs.existsSync(path.join(projectSessionsDir(dir), `${id}.jsonl`)),
+  };
+}
+
+type SpawnClaudePty = ReturnType<typeof createClaudeSpawner>["spawnClaudePty"];
+
+export function mountTraceHunterImportRoutes(app: Express, spawnClaudePty: SpawnClaudePty, reap: (id: string) => void): void {
+  const idOf = (req: Request): string => typeof req.params.id === "string" ? req.params.id : "";
+  const authorized = (req: Request): boolean => privateRequest(req) && SESSION_ID_RE.test(idOf(req));
+  app.put(`${base}/:id/attachments/:attachmentId`, express.raw({ type: () => true, limit: maxUpload }), (req, res) => {
+    if (!authorized(req)) return res.sendStatus(403);
+    const attachment = String(req.params.attachmentId);
+    if (!SESSION_ID_RE.test(attachment)) return res.sendStatus(400);
+    const bytes: unknown = req.body;
+    const expected = req.get("X-Content-SHA256") || "";
+    if (!Buffer.isBuffer(bytes) || !/^[0-9a-f]{64}$/.test(expected) || hashOf(bytes) !== expected) return res.sendStatus(422);
+    const dir = dirOf(idOf(req));
+    if (fs.existsSync(path.join(dir, "job.json"))) return res.sendStatus(409);
+    const folder = path.join(prepareJob(idOf(req)), "attachments");
+    fs.mkdirSync(folder, { recursive: true, mode: 0o700 });
+    let suppliedName = "trace.json";
+    try { suppliedName = decodeURIComponent(req.get("X-Trace-Name") || suppliedName); }
+    catch { return res.sendStatus(400); }
+    const name = filename(suppliedName);
+    const target = path.join(folder, `${attachment}-${name}`);
+    if (fs.existsSync(target) && hashOf(fs.readFileSync(target)) !== expected) return res.sendStatus(409);
+    if (!fs.existsSync(target)) fs.writeFileSync(target, bytes, { mode: 0o600 });
+    return res.json({ path: target, sha256: expected });
+  });
+
+  app.post(`${base}/:id/start`, express.json({ limit: "1mb" }), (req, res) => {
+    if (!authorized(req)) return res.sendStatus(403);
+    const body: unknown = req.body;
+    if (!body || typeof body !== "object") return res.sendStatus(400);
+    const job = body as Record<string, unknown>;
+    const { turnId, taskId, project, prompt, telemetryToken, sourceSha256 } = job;
+    const kind = job.kind === "agent" ? "agent" : "import";
+    if (typeof turnId !== "string" || !SESSION_ID_RE.test(turnId) ||
+        (kind === "import" && (typeof taskId !== "string" || !/^task-[0-9a-f]{24}$/.test(taskId))) ||
+        (kind === "agent" && taskId !== undefined && (typeof taskId !== "string" || !/^task-[0-9a-f]{24}$/.test(taskId))) ||
+        typeof project !== "string" || !/^[A-Za-z0-9._-]{1,128}$/.test(project) ||
+        typeof prompt !== "string" || !prompt || prompt.length > 200_000 ||
+        typeof telemetryToken !== "string" || telemetryToken.length < 32 || telemetryToken.length > 128 ||
+        (kind === "import" && (typeof sourceSha256 !== "string" || !/^[0-9a-f]{64}$/.test(sourceSha256))) ||
+        (kind === "agent" && sourceSha256 !== undefined)) return res.sendStatus(400);
+    const pluginDir = process.env.TRACE_HUNTER_IMPORT_PLUGIN_DIR;
+    if (!pluginDir || !fs.existsSync(path.join(pluginDir, ".claude-plugin", "plugin.json"))) return res.status(503).json({ error: "Recorder plugin unavailable" });
+    const dir = prepareJob(idOf(req));
+    const attachmentDir = path.join(dir, "attachments");
+    if (kind === "import" && (!fs.existsSync(attachmentDir) || !fs.readdirSync(attachmentDir).some(name =>
+      hashOf(fs.readFileSync(path.join(attachmentDir, name))) === sourceSha256))) return res.status(409).json({ error: "Verified attachment missing" });
+    const manifest = path.join(dir, "job.json");
+    const digest = hashOf(JSON.stringify(kind === "import"
+      ? { turnId, taskId, project, prompt, sourceSha256 }
+      : { turnId, taskId, project, prompt, kind }));
+    if (fs.existsSync(manifest)) {
+      const saved = JSON.parse(fs.readFileSync(manifest, "utf8")) as { digest?: string };
+      if (saved.digest !== digest) return res.sendStatus(409);
+      const evidence = sessionEvidence(idOf(req), dir);
+      // A crash after reserving job.json but before spawning must not be reported as a
+      // running terminal. Never launch a second process for an ambiguous existing job.
+      if (!evidence.live && !evidence.transcript && !fs.existsSync(path.join(dir, "import-result.json")))
+        return res.status(503).json({ error: "Import terminal has no process or transcript" });
+      return res.json({ sessionId: idOf(req), cwd: dir, reused: true });
+    }
+    const api = process.env.TRACE_HUNTER_IMPORT_API_URL || "http://127.0.0.1:8767";
+    const endpoint = `${api}/api/v1/agent/worker/turns/${turnId}/otel`;
+    const env = {
+      TRACE_HUNTER_PROJECT: project, TRACE_HUNTER_PROFILE: "terminal",
+      TRACE_HUNTER_AGENT_SESSION_ID: idOf(req),
+      TRACE_HUNTER_AGENT_HOOK_PATH: path.join(dir, "hook.jsonl"),
+      CLAUDE_CODE_ENABLE_TELEMETRY: "1", CLAUDE_CODE_ENHANCED_TELEMETRY_BETA: "1",
+      OTEL_LOGS_EXPORTER: "otlp", OTEL_TRACES_EXPORTER: "otlp", OTEL_METRICS_EXPORTER: "none",
+      OTEL_EXPORTER_OTLP_PROTOCOL: "http/json",
+      OTEL_EXPORTER_OTLP_LOGS_ENDPOINT: `${endpoint}/v1/logs`,
+      OTEL_EXPORTER_OTLP_TRACES_ENDPOINT: `${endpoint}/v1/traces`,
+      OTEL_EXPORTER_OTLP_HEADERS: `X-Trace-Hunter-Recorder-Token=${telemetryToken}`,
+      OTEL_LOG_RAW_API_BODIES: `file:${path.join(dir, "body")}`,
+    };
+    fs.mkdirSync(path.join(dir, "body"), { mode: 0o700 });
+    fs.writeFileSync(manifest, JSON.stringify({ digest, turnId, taskId, project, sourceSha256, kind }), { flag: "wx", mode: 0o600 });
+    try {
+      spawnClaudePty(idOf(req), null, null, { cwd: dir,
+        initialPrompt: fs.existsSync(attachmentDir) && fs.readdirSync(attachmentDir).length
+          ? `${prompt}\n\n本次会话已附加原始文件，存放于：${attachmentDir}` : prompt,
+        traceHunterRecorder: { pluginDir, env } });
+    } catch (error) {
+      fs.rmSync(manifest);
+      return res.status(503).json({ error: String(error) });
+    }
+    return res.status(201).json({ sessionId: idOf(req), cwd: dir, reused: false });
+  });
+
+  app.get(`${base}/:id/status`, (req, res) => {
+    if (!authorized(req)) return res.sendStatus(403);
+    const dir = dirOf(idOf(req));
+    if (!fs.existsSync(path.join(dir, "job.json"))) return res.sendStatus(404);
+    const evidence = sessionEvidence(idOf(req), dir);
+    return res.json({ sessionId: idOf(req), cwd: dir, live: evidence.live, stopped: stopped(dir),
+      receipt: fs.existsSync(path.join(dir, "import-result.json")),
+      transcript: evidence.transcript });
+  });
+
+  app.get(`${base}/:id/files/:file`, (req, res) => {
+    if (!authorized(req)) return res.sendStatus(403);
+    const dir = dirOf(idOf(req));
+    const names: Record<string, string> = {
+      transcript: path.join(projectSessionsDir(dir), `${idOf(req)}.jsonl`),
+      hooks: path.join(dir, "hook.jsonl"), receipt: path.join(dir, "import-result.json"),
+      "body-index": path.join(dir, "body", "index.jsonl"),
+    };
+    const file = names[String(req.params.file)];
+    if (!file || !fs.existsSync(file) || fs.lstatSync(file).isSymbolicLink()) return res.sendStatus(404);
+    return res.type("application/octet-stream").sendFile(file, { dotfiles: "allow" });
+  });
+
+  app.get(`${base}/:id/body`, (req, res) => {
+    if (!authorized(req)) return res.sendStatus(403);
+    const dir = dirOf(idOf(req));
+    if (!fs.existsSync(path.join(dir, "job.json"))) return res.sendStatus(404);
+    const body = path.join(dir, "body");
+    const names = fs.existsSync(body) ? fs.readdirSync(body).filter(name =>
+      /^[A-Za-z0-9._-]{1,255}\.(request|response)\.json$/.test(name) &&
+      !fs.lstatSync(path.join(body, name)).isSymbolicLink() && fs.statSync(path.join(body, name)).isFile()) : [];
+    return res.json({ names });
+  });
+
+  app.get(`${base}/:id/body/:name`, (req, res) => {
+    if (!authorized(req)) return res.sendStatus(403);
+    const name = String(req.params.name);
+    if (!/^[A-Za-z0-9._-]{1,255}\.(request|response)\.json$/.test(name)) return res.sendStatus(400);
+    const file = path.join(dirOf(idOf(req)), "body", name);
+    if (!fs.existsSync(file) || fs.lstatSync(file).isSymbolicLink() || !fs.statSync(file).isFile()) return res.sendStatus(404);
+    return res.type("application/octet-stream").sendFile(file, { dotfiles: "allow" });
+  });
+
+  app.get(`${base}/:id/script/:name`, (req, res) => {
+    if (!authorized(req)) return res.sendStatus(403);
+    const name = String(req.params.name);
+    if (!/^[A-Za-z0-9._-]{1,255}\.py$/.test(name)) return res.sendStatus(400);
+    const file = path.join(dirOf(idOf(req)), name);
+    if (!fs.existsSync(file) || fs.lstatSync(file).isSymbolicLink() || !fs.statSync(file).isFile() || fs.statSync(file).size > 262_144) return res.sendStatus(404);
+    return res.type("text/x-python").sendFile(file, { dotfiles: "allow" });
+  });
+
+  app.get(`${base}/:id/subagent/:name`, (req, res) => {
+    if (!authorized(req)) return res.sendStatus(403);
+    const name = String(req.params.name);
+    if (!/^agent-[A-Za-z0-9_-]{1,128}\.jsonl$/.test(name)) return res.sendStatus(400);
+    const project = projectSessionsDir(dirOf(idOf(req)));
+    const candidates = [path.join(project, idOf(req), "subagents", name),
+                        path.join(project, "subagents", name)];
+    const file = candidates.find(candidate => fs.existsSync(candidate) &&
+      !fs.lstatSync(candidate).isSymbolicLink() && fs.statSync(candidate).isFile() &&
+      fs.statSync(candidate).size <= 16 * 1024 * 1024);
+    if (!file) return res.sendStatus(404);
+    return res.type("application/octet-stream").sendFile(file, { dotfiles: "allow" });
+  });
+
+  app.post(`${base}/:id/cancel`, (req, res) => {
+    if (!authorized(req)) return res.sendStatus(403);
+    if (!fs.existsSync(path.join(dirOf(idOf(req)), "job.json"))) return res.sendStatus(404);
+    reap(idOf(req));
+    return res.json({ cancelled: true });
+  });
+}
