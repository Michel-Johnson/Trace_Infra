+
+  it("starts an ordinary Agent in the same Claude PTY without a fake import attachment", async () => {
+    const url = `/api/internal/trace-hunter/imports/${agentSession}`;
+    const job = { kind: "agent", turnId: randomUUID(), project: "synthetic",
+      prompt: "Evaluate the synthetic case", telemetryToken: "synthetic-otel-token-0123456789012345" };
+    const started = await call(url + "/start", jsonPost(job, headers));
