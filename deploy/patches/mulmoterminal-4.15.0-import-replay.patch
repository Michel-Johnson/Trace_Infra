+import { afterEach, describe, expect, it, vi } from "vitest";
+import { replayEventText, safeReplayText, startTraceHunterReplay } from "../../../src/composables/traceHunterReplay";
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe("Trace Hunter read-only terminal replay", () => {
+  it("strips terminal control sequences from untrusted Agent output", () => {
+    expect(safeReplayText("before\x1b[2J\x1b]52;c;secret\x07after"))
+      .toBe("before[2J]52;c;secretafter");
+    expect(replayEventText({ id: 1, turn_id: "t", type: "message",
+      payload: { text: "hello\nworld", tools: [{ name: "Bash" }] } }, "http://local"))
+      .toBe("hello\nworld\n[调用工具] Bash");
+  });
+
+  it("reads an already completed import without opening a PTY or SSE stream", async () => {
+    const id = "d410918e-34e5-5a13-bff5-2e63865bae2c";
+    const outputs: string[] = [];
+    const status = vi.fn();
+    const fetch = vi.fn(async (url: string) => ({ ok: true, json: async () => {
+      if (url.endsWith(`/sessions/${id}`)) return { session_id: id, project_id: "synthetic",
+        turns: [{ turn_id: "t1", ordinal: 1, prompt: "导入合成文件", state: "succeeded", task_id: "job-1" }] };
+      if (url.includes("/events/page")) return { items: [{ id: 1, turn_id: "t1", type: "message",
+        payload: { text: "Adapter 已选择" } }] };
+      return { state: "succeeded", current_stage: "readback", progress: 1,
+        result: { run_id: "synthetic-run", revision: 1 } };
+    } }));
+    const stream = vi.fn();
+    vi.stubGlobal("fetch", fetch);
+    vi.stubGlobal("EventSource", stream);
+    const stop = startTraceHunterReplay(id, text => outputs.push(text), status);
+    await vi.waitFor(() => expect(outputs.join(" ")).toContain("[导入成功]"));
+    expect(outputs.join(" ")).toContain("Adapter 已选择");
+    expect(stream).not.toHaveBeenCalled();
+    expect(fetch.mock.calls.every(([url]) => url.startsWith("/api/v1/"))).toBe(true);
+    expect(status).toHaveBeenCalledWith("connected");
+    stop();
+  });
+
+  it("rejects an invalid session id without fetching or launching anything", async () => {
+    const outputs: string[] = [];
+    const fetch = vi.fn();
+    vi.stubGlobal("fetch", fetch);
+    const stop = startTraceHunterReplay("bad/id", text => outputs.push(text), vi.fn());
+    await vi.waitFor(() => expect(outputs.join(" ")).toContain("无效的导入会话 ID"));
+    expect(fetch).not.toHaveBeenCalled();
+    stop();
+  });
+
+  it("follows live Agent events once, then closes the read-only stream", async () => {
+    const id = "d410918e-34e5-5a13-bff5-2e63865bae2c";
+    const outputs: string[] = [];
+    const listeners = new Map<string, (event: MessageEvent) => void>();
+    const close = vi.fn();
+    const stream = vi.fn().mockImplementation(function () {
+      return { addEventListener: (name: string, listener: (event: MessageEvent) => void) => listeners.set(name, listener),
+        close, onopen: null, onerror: null };
+    });
+    vi.stubGlobal("EventSource", stream);
+    vi.stubGlobal("fetch", vi.fn(async (url: string) => ({ ok: true, json: async () =>
+      url.includes("/events/page") ? { items: [] } : { session_id: id, project_id: "synthetic",
+        turns: [{ turn_id: "t1", ordinal: 1, prompt: "导入合成文件", state: "running", task_id: null }] } })));
+    const stop = startTraceHunterReplay(id, text => outputs.push(text), vi.fn());
+    await vi.waitFor(() => expect(stream).toHaveBeenCalledOnce());
+    const event = { data: JSON.stringify({ id: 1, turn_id: "t1", type: "message", payload: { text: "处理中" } }) } as MessageEvent;
+    listeners.get("message")?.(event);
+    listeners.get("message")?.(event);
+    expect(outputs.join(" ").match(/处理中/g)).toHaveLength(1);
+    stop();
+    expect(close).toHaveBeenCalledOnce();
+  });
+});
