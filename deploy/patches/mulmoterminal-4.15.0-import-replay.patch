new file mode 100644
index 00000000..29ccb052
--- /dev/null
+++ b/src/components/terminalSlotKey.ts
@@ -0,0 +1,6 @@
+// The internal HTTP origin is not a secure context and may lack crypto.randomUUID.
+// This is a local xterm slot identity, never a credential or persistent session ID.
+export function ephemeralSlotKey(randomUUID: (() => string) | null | undefined = globalThis.crypto?.randomUUID?.bind(globalThis.crypto)): string {
+  const id = randomUUID?.() ?? `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
+  return `ephemeral-${id}`;
+}
diff --git a/src/composables/traceHunterReplay.ts b/src/composables/traceHunterReplay.ts
new file mode 100644
index 00000000..c5f44782
--- /dev/null
+++ b/src/composables/traceHunterReplay.ts
@@ -0,0 +1,156 @@
+// A read-only source for Mulmo's existing xterm canvas. It never opens a PTY,
+// resumes Claude, or sends input to the Agent worker.
+type ReplayTurn = { turn_id: string; ordinal: number; prompt: string; state: string; task_id: string | null };
+type ReplaySession = { session_id: string; project_id: string; turns: ReplayTurn[] };
+type ReplayEvent = { id: number; turn_id: string; type: string; payload: Record<string, unknown> };
+type ReplayTask = {
+  state: string;
+  current_stage?: string | null;
+  progress?: number;
+  error?: string | { message?: string } | null;
+  result?: { run_id?: string; revision?: number } | null;
+};
+
+const uuid = /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i;
+const finalStates = new Set(["succeeded", "failed", "cancelled"]);
+const stages: Record<string, string> = {
+  format_inspect: "识别格式", adapter_select: "选择或开发 Adapter",
+  adapter_validate: "校验字段与来源", trace_import: "导入 Trace", readback: "回读结果",
+};
+
+// Imported prompts and tool output are untrusted terminal input. Do not let
+// their control bytes move the cursor, overwrite evidence, or set clipboard data.
+export function safeReplayText(value: unknown, limit = 8192): string {
+  const source = String(value ?? "");
+  const clipped = source.length > limit ? `${source.slice(0, limit)}…（已截断）` : source;
+  return clipped.replace(/[\u0000-\u0009\u000b-\u001f\u007f-\u009f\u202a-\u202e\u2066-\u2069]/g, "");
+}
+
+export function replayEventText(event: ReplayEvent, origin: string): string | null {
+  const data = event.payload || {};
+  if (event.type === "message") {
+    const text = safeReplayText(data.text);
+    const tools = Array.isArray(data.tools)
+      ? data.tools.map((tool) => safeReplayText((tool as { name?: unknown })?.name || "Tool", 100)) : [];
+    return [text, ...tools.map((tool) => `[调用工具] ${tool}`)].filter(Boolean).join("\n");
+  }
+  if (event.type === "tool_result") {
+    const label = data.is_error ? "工具失败" : "工具返回";
+    return `[${label}] ${safeReplayText(data.tool_use_id, 120)}\n${safeReplayText(data.content, 4096)}`;
+  }
+  if (event.type === "retry") return `[重试] ${safeReplayText(data.error, 1000)}`;
+  if (event.type === "failed" || event.type === "cancelled")
+    return `[Agent ${event.type === "failed" ? "失败" : "已取消"}] ${safeReplayText(data.error, 1000)}`;
+  if (event.type === "succeeded") return "[Agent 回合完成；等待导入结果回读]";
+  if (event.type === "trace_ready" && typeof data.run_id === "string" && typeof data.project_id === "string") {
+    const url = `${origin}/#/traces/${encodeURIComponent(data.run_id)}?project=${encodeURIComponent(data.project_id)}&revision=${Number(data.revision) || 1}`;
+    return `[Agent Trace] ${url}`;
+  }
+  return null; // delta is omitted: the final message contains the same text.
+}
+
+export function startTraceHunterReplay(sessionId: string, write: (text: string) => void,
+  status: (value: "connecting" | "connected" | "disconnected") => void): () => void {
+  const controller = new AbortController();
+  let stopped = false;
+  let stream: EventSource | null = null;
+  let timer: ReturnType<typeof setInterval> | null = null;
+  let lastEventId = 0;
+  let lastTaskLabel = "";
+  let taskDone = false;
+  const shownTurns = new Set<string>();
+  const print = (text: string) => { if (!stopped) write(`${text.replace(/\r?\n/g, "\r\n")}\r\n`); };
+  const request = async <T>(url: string): Promise<T> => {
+    const response = await fetch(url, { credentials: "same-origin", signal: controller.signal });
+    if (!response.ok) throw new Error(response.status === 404
+      ? "当前浏览器无法读取该会话；它可能由另一个浏览器发起" : `HTTP ${response.status}`);
+    return response.json() as Promise<T>;
+  };
+  const start = async () => {
+    if (!uuid.test(sessionId)) throw new Error("无效的导入会话 ID");
+    const root = `/api/v1/agent/sessions/${encodeURIComponent(sessionId)}`;
+    const session = await request<ReplaySession>(root);
+    if (stopped) return;
+    status("connected");
+    print(`Trace Hunter 导入任务 · 只读终端\n项目：${safeReplayText(session.project_id, 120)}\n会话：${safeReplayText(session.session_id, 120)}`);
+    const turns = new Map(session.turns.map((turn) => [turn.turn_id, turn]));
+    const showTurn = (turnId: string) => {
+      if (shownTurns.has(turnId)) return;
+      shownTurns.add(turnId);
+      const turn = turns.get(turnId);
+      if (turn) print(`\n── 回合 ${turn.ordinal} ──\n${safeReplayText(turn.prompt, 4096)}`);
+    };
+    const showEvent = (event: ReplayEvent) => {
+      if (!Number.isSafeInteger(event.id) || event.id <= lastEventId) return;
+      lastEventId = event.id;
+      showTurn(event.turn_id);
+      const text = replayEventText(event, window.location.origin);
+      if (text) print(text);
+    };
+    while (!stopped) {
+      const page = await request<{ items: ReplayEvent[] }>(`${root}/events/page?after=${lastEventId}`);
+      for (const event of page.items) showEvent(event);
+      if (page.items.length < 200) break;
+    }
+    if (stopped) return;
+    const latest = session.turns.at(-1);
+    if (latest) showTurn(latest.turn_id);
+    const taskTurn = [...session.turns].reverse().find((turn) => turn.task_id);
+    if (taskTurn?.task_id) {
+      const taskUrl = `/api/v1/projects/${encodeURIComponent(session.project_id)}/tasks/${encodeURIComponent(taskTurn.task_id)}`;
+      const poll = async () => {
+        try {
+          const task = await request<ReplayTask>(taskUrl);
+          if (stopped) return;
+          const stage = task.current_stage ? stages[task.current_stage] || safeReplayText(task.current_stage, 100) : "等待处理";
+          const progress = typeof task.progress === "number" ? ` · ${Math.round(task.progress * 100)}%` : "";
+          const label = `${task.state} · ${stage}${progress}`;
+          if (label !== lastTaskLabel) {
+            lastTaskLabel = label;
+            print(`[导入任务] ${label}`);
+          }
+          if (finalStates.has(task.state)) {
+            taskDone = true;
+            if (task.state === "succeeded" && task.result?.run_id) {
+              print(`[导入成功] ${window.location.origin}/#/traces/${encodeURIComponent(task.result.run_id)}?project=${encodeURIComponent(session.project_id)}&revision=${task.result.revision || 1}`);
+            } else if (task.state !== "succeeded") {
+              const error = typeof task.error === "string" ? task.error : task.error?.message;
+              print(`[导入${task.state === "cancelled" ? "已取消" : "失败"}] ${safeReplayText(error || "请查看任务详情", 1000)}`);
+            }
+            if (timer) clearInterval(timer);
+            timer = null;
+            stream?.close();
+            stream = null;
+          }
+        } catch (error) {
+          if (!stopped && !(error instanceof DOMException && error.name === "AbortError"))
+            print(`[任务状态读取失败] ${safeReplayText(error, 300)}`);
+        }
+      };
+      await poll();
+      if (!stopped && !taskDone) {
+        timer = setInterval(() => void poll(), 1500);
+      }
+    }
+    if (stopped || taskDone || finalStates.has(latest?.state || "")) return;
+    stream = new EventSource(`${root}/events?after=${lastEventId}`);
+    const types = ["queued", "running", "message", "tool_result", "retry", "trace_ready", "succeeded", "failed", "cancelled"];
+    for (const type of types) stream.addEventListener(type, (event) => {
+      try { showEvent(JSON.parse((event as MessageEvent).data) as ReplayEvent); }
+      catch { print("[会话事件格式无效]"); }
+    });
+    stream.onopen = () => { if (!stopped) status("connected"); };
+    stream.onerror = () => { if (!stopped) status("connecting"); };
+  };
+  void start().catch((error) => {
+    if (stopped || (error instanceof DOMException && error.name === "AbortError")) return;
+    status("disconnected");
+    print(`无法读取导入会话：${safeReplayText(error, 300)}。不会启动新的 Claude 会话。`);
+  });
+  return () => {
+    stopped = true;
+    controller.abort();
+    stream?.close();
+    if (timer) clearInterval(timer);
+  };
+}
