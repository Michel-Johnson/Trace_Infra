{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-hunter:trace:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "trace-hunter/1.0"
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]{1,100}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "task_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "harness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "status": {
          "enum": [
            "completed",
            "partial",
            "running",
            "failed"
          ]
        },
        "time_basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "id",
        "title",
        "task_key",
        "query",
        "harness",
        "model",
        "status",
        "time_basis"
      ],
      "additionalProperties": false
    },
    "collector": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "name",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "coverage": {
      "type": "object",
      "properties": {
        "tools": {
          "enum": [
            "complete",
            "partial",
            "missing"
          ]
        },
        "model_requests": {
          "enum": [
            "complete",
            "partial",
            "missing"
          ]
        }
      },
      "required": [
        "tools",
        "model_requests"
      ],
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "purpose": {
            "enum": [
              "task",
              "setup",
              "export"
            ]
          },
          "start_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "end_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "coverage": {
            "type": "object",
            "properties": {
              "tools": {
                "enum": [
                  "complete",
                  "partial",
                  "missing"
                ]
              },
              "model_requests": {
                "enum": [
                  "complete",
                  "partial",
                  "missing"
                ]
              }
            },
            "required": [
              "tools",
              "model_requests"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "purpose",
          "start_ms",
          "end_ms"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "spans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/span"
      },
      "maxItems": 20000
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "type": {
            "enum": [
              "invokes",
              "follows",
              "retry_of"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "type"
        ],
        "additionalProperties": false
      },
      "maxItems": 20000
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "kind": {
            "enum": [
              "assertion",
              "artifact",
              "note"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "observed",
              "unknown"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 200000
          },
          "span_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "maxItems": 20000
          },
          "source": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "status",
          "detail",
          "span_ids",
          "source"
        ],
        "additionalProperties": false
      },
      "maxItems": 20000
    }
  },
  "required": [
    "schema_version",
    "run",
    "collector",
    "sources",
    "coverage",
    "phases",
    "spans",
    "links",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "span": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "kind": {
          "enum": [
            "tool",
            "model",
            "wait",
            "agent"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "operation": {
          "enum": [
            "read",
            "write",
            "bash",
            "skill",
            "human",
            "other"
          ]
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "phase_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "start_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "end_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "duration_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "unknown",
            "running"
          ]
        },
        "input": {},
        "output": {},
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source_ref"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "operation",
        "agent_id",
        "parent_id",
        "request_id",
        "attempt",
        "phase_id",
        "start_ms",
        "end_ms",
        "duration_ms",
        "status",
        "input",
        "output",
        "usage",
        "source"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "thinking_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "thinking_tokens"
      ],
      "additionalProperties": false
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "pointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "source_id",
        "pointer"
      ],
      "additionalProperties": false
    }
  }
}
