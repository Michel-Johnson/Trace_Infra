                "uniqueItems": true
              },
              "consumes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              },
              "config_schema": {
                "type": "object"
              },
              "default_config": {
                "type": "object"
              },
              "trigger": {
                "const": "explicit"
              },
              "output_kind": {
                "const": "facets"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "enum": [
                    "trace.read",
                    "derived.read",
                    "facets.submit"
                  ]
                },
                "minItems": 0,
                "maxItems": 100,
                "uniqueItems": true
              },
              "mode": {
                "const": "classify"
              }
            },
            "required": [
              "id",
              "title",
              "kind",
              "implementation",
              "scopes",
              "consumes",
              "config_schema",
              "default_config",
              "trigger",
              "output_kind",
              "permissions",
              "mode"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*\\.[a-zA-Z0-9_.-]+$": {}
      },
      "additionalProperties": false
    }
