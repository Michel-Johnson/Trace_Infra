                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "host",
                  "ref"
                ],
                "additionalProperties": false
              },
              "scopes": {
                "type": "array",
                "items": {
                  "enum": [
                    "collection",
                    "case",
                    "run",
                    "turn",
                    "span",
                    "artifact",
                    "comparison"
                  ]
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              },
              "consumes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              },
              "config_schema": {
                "type": "object"
              },
              "default_config": {
                "type": "object"
              },
              "trigger": {
                "const": "interaction"
              },
              "output_kind": {
                "const": "selection"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "enum": [
                    "trace.read",
                    "derived.read"
                  ]
                },
                "minItems": 0,
                "maxItems": 100,
                "uniqueItems": true
              },
              "mode": {
                "const": "filter"
              }
            },
            "required": [
              "id",
              "title",
              "kind",
              "implementation",
              "scopes",
              "consumes",
              "config_schema",
              "default_config",
              "trigger",
              "output_kind",
              "permissions",
              "mode"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "const": "slicer"
              },
              "implementation": {
                "type": "object",
                "properties": {
                  "host": {
                    "enum": [
