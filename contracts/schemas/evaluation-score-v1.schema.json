{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "evaluated",
        "partial",
        "insufficient_data",
        "skipped"
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "value": {
            "type": [
              "number",
              "boolean",
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "evaluated",
              "partial",
              "insufficient_data",
              "skipped"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 10000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "span",
                    "evidence",
                    "phase"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            "maxItems": 200
          }
        },
        "required": [
          "key",
          "value",
          "status",
          "reason",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 10000
          },
          "repair_suggestion": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 10000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "span",
                    "evidence",
                    "phase"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            "maxItems": 200
          }
        },
        "required": [
          "code",
          "severity",
          "message",
          "repair_suggestion",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cost",
        "currency"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "status",
    "metrics",
    "findings",
    "usage"
  ],
  "additionalProperties": false
}
