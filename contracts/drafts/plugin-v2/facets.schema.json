{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "trace-hunter/facets/1.0-draft.1"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "document_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "selection_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "document_id",
          "document_digest",
          "selection_digest"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "coverage": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "facets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "cardinality": {
            "enum": [
              "single",
              "multiple"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": [
          "id",
          "title",
          "cardinality",
          "values"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "document_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "entity_kind": {
                "enum": [
                  "collection",
                  "case",
                  "run",
                  "turn",
                  "span",
                  "artifact"
                ]
              },
              "entity_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "document_id",
              "document_digest",
              "entity_kind",
              "entity_id"
            ],
            "additionalProperties": false
          },
          "facet_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "enum": [
              "assigned",
              "unknown",
              "not_applicable"
            ]
          },
          "value_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 10000
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "document_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "entity_kind": {
                  "enum": [
                    "collection",
                    "case",
                    "run",
                    "turn",
                    "span",
                    "artifact"
                  ]
                },
                "entity_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "document_id",
                "document_digest",
                "entity_kind",
                "entity_id"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 100
          }
        },
        "required": [
          "target",
          "facet_id",
          "status",
          "value_ids",
          "reason",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "assigned"
                }
              }
            },
            "then": {
              "properties": {
                "value_ids": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "unknown",
                    "not_applicable"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value_ids": {
                  "maxItems": 0
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 20000
    }
  },
  "required": [
    "schema_version",
    "input_refs",
    "coverage",
    "facets",
    "assignments"
  ],
  "additionalProperties": false
}
