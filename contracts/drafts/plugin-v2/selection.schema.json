{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "trace-hunter/selection/1.0-draft.1"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "document_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "selection_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "document_id",
          "document_digest",
          "selection_digest"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "document_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "entity_kind": {
            "enum": [
              "collection",
              "case",
              "run",
              "turn",
              "span",
              "artifact"
            ]
          },
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "document_id",
          "document_digest",
          "entity_kind",
          "entity_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 20000
    }
  },
  "required": [
    "schema_version",
    "input_refs",
    "members"
  ],
  "additionalProperties": false
}
