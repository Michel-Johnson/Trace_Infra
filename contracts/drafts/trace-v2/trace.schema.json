{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-hunter:trace:2.0-draft.1",
  "title": "Trace Hunter v2 design prototype — not accepted by the live API",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "trace-hunter/2.0-draft.1"
    },
    "document": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "previous_document_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "sealed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "revision",
        "previous_document_id",
        "sealed"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "query_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "env_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "harness": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "lineage": {
          "type": "object",
          "properties": {
            "parent_run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "parent_document_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "checkpoint_ref": {
              "$ref": "#/$defs/source_ref"
            }
          },
          "required": [
            "parent_run_id",
            "parent_document_id",
            "checkpoint_ref"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "harness",
        "status",
        "environment"
      ],
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "properties": {
        "collector": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "tools": {
              "enum": [
                "complete",
                "partial",
                "missing",
                "unknown"
              ]
            },
            "model_requests": {
              "enum": [
                "complete",
                "partial",
                "missing",
                "unknown"
              ]
            },
            "messages": {
              "enum": [
                "complete",
                "partial",
                "missing",
                "unknown"
              ]
            },
            "contexts": {
              "enum": [
                "complete",
                "partial",
                "missing",
                "unknown"
              ]
            },
            "timing": {
              "enum": [
                "complete",
                "partial",
                "missing",
                "unknown"
              ]
            }
          },
          "required": [
            "tools",
            "model_requests",
            "messages",
            "contexts",
            "timing"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          },
          "maxItems": 100
        }
      },
      "required": [
        "collector",
        "coverage"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 20000
    },
    "clocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clock"
      },
      "maxItems": 20000
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      },
      "maxItems": 20000
    },
    "spans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/span"
      },
      "maxItems": 20000
    },
    "turns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/turn"
      },
      "maxItems": 20000
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      },
      "maxItems": 20000
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      },
      "maxItems": 20000
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "maxItems": 20000
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      },
      "maxItems": 20000
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "maxItems": 20000
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool_call"
      },
      "maxItems": 20000
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "purpose": {
            "enum": [
              "task",
              "setup",
              "export"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "timing": {
            "$ref": "#/$defs/timing"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source_ref"
            },
            "maxItems": 100,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "purpose"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "required": [
    "schema_version",
    "document",
    "run",
    "capture",
    "sources",
    "segments",
    "spans"
  ],
  "additionalProperties": false,
  "$defs": {
    "source_ref": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "pointer": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "source_id",
        "pointer"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "type": "string",
          "maxLength": 100000
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "enum": [
            "available",
            "external",
            "missing",
            "redacted"
          ]
        }
      },
      "required": [
        "id",
        "sha256",
        "state"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "complete",
            "partial",
            "missing",
            "redacted"
          ]
        },
        "value": {},
        "ref": {
          "$ref": "#/$defs/source_ref"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "state": {
              "enum": [
                "complete",
                "partial"
              ]
            }
          },
          "oneOf": [
            {
              "required": [
                "value"
              ],
              "not": {
                "required": [
                  "ref"
                ]
              }
            },
            {
              "required": [
                "ref"
              ],
              "not": {
                "required": [
                  "value"
                ]
              }
            }
          ]
        },
        {
          "properties": {
            "state": {
              "enum": [
                "missing",
                "redacted"
              ]
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              }
            ]
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "properties": {
        "isolation": {
          "enum": [
            "sandbox",
            "non_sandbox",
            "unknown"
          ]
        },
        "network_access": {
          "enum": [
            "allowed",
            "blocked",
            "unknown"
          ]
        },
        "snapshot_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/source_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "required": [
        "isolation",
        "network_access"
      ],
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "monotonic",
            "wall",
            "unknown"
          ]
        },
        "origin_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "clock_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "start_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "end_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "first_response_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_basis": {
          "enum": [
            "interval_derived",
            "source_reported"
          ]
        },
        "duration_scope": {
          "enum": [
            "elapsed",
            "active",
            "unknown"
          ]
        },
        "last_response_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "response_boundary": {
          "enum": [
            "first_byte",
            "first_content",
            "first_token",
            "unknown"
          ]
        }
      },
      "required": [
        "clock_id",
        "start_ms",
        "end_ms"
      ],
      "additionalProperties": false
    },
    "order": {
      "type": "object",
      "properties": {
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "stream_id",
        "sequence"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_read_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_write_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false
    },
    "usage_component": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "purpose": {
          "enum": [
            "generation",
            "compaction",
            "other"
          ]
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "maxItems": 100,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "purpose",
        "counts",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "accounting": {
          "enum": [
            "total",
            "components"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "total": {
          "$ref": "#/$defs/counts"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usage_component"
          },
          "maxItems": 1000,
          "minItems": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "maxItems": 100,
          "minItems": 1
        }
      },
      "required": [
        "accounting",
        "completeness",
        "source_refs"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "accounting": {
              "const": "total"
            }
          },
          "required": [
            "total"
          ],
          "not": {
            "required": [
              "components"
            ]
          }
        },
        {
          "properties": {
            "accounting": {
              "const": "components"
            }
          },
          "required": [
            "components"
          ],
          "not": {
            "required": [
              "total"
            ]
          }
        }
      ]
    },
    "call": {
      "type": "object",
      "properties": {
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "provider_request_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "invocation_id",
        "attempt"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "response_model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "request_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "context_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "output_message_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 20000
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/usage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "requested_model",
        "request_count",
        "context_id",
        "usage"
      ],
      "additionalProperties": false
    },
    "tool_call": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "call_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "arguments": {
          "$ref": "#/$defs/content"
        },
        "model_span_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "maxItems": 100,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "name",
        "arguments",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "read",
            "write",
            "bash",
            "human",
            "other"
          ]
        },
        "call_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "proposal_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "skill": {
          "type": "object",
          "properties": {
            "name": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            },
            "action": {
              "enum": [
                "load",
                "invoke"
              ]
            }
          },
          "required": [
            "name",
            "action"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "operation"
      ],
      "additionalProperties": false
    },
    "wait": {
      "type": "object",
      "properties": {
        "reason": {
          "enum": [
            "human_input",
            "approval",
            "rate_limit",
            "queue",
            "external",
            "unknown"
          ]
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "model",
            "model_batch",
            "tool",
            "agent",
            "wait",
            "other"
          ]
        },
        "name": {
