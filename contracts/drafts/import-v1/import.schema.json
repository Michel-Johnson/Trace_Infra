{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-hunter:import:1.0-draft.1",
  "title": "Neutral trace import batch — offline design only",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "trace-hunter-import/1.0-draft.1"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "trace"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "trace": {"$ref": "urn:trace-hunter:trace:2.0-draft.1"}
        }
      }
    }
  }
}
