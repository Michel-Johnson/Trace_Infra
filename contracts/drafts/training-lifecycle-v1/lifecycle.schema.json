{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-hunter:training-lifecycle:0.1-draft",
  "description": "Offline design only; current HTTP API does not accept these objects.",
  "oneOf": [
    {
      "$ref": "#/$defs/selection"
    },
    {
      "$ref": "#/$defs/analysis_request"
    },
    {
      "$ref": "#/$defs/replay"
    },
    {
      "$ref": "#/$defs/validation"
    },
    {
      "$ref": "#/$defs/dataset"
    },
    {
      "$ref": "#/$defs/consumption"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "trace-hunter/training-lifecycle/0.1-draft"
        },
        "kind": {
          "const": "selection"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        },
        "query_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trace_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/ref"
              },
              {
                "properties": {
                  "kind": {
                    "enum": [
                      "trace"
                    ]
                  }
                }
              }
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "selection_manifest_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "artifact"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "revision",
        "resolved_at",
        "query_digest",
        "trace_refs",
        "selection_manifest_ref"
      ],
      "additionalProperties": false
    },
    "analysis_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "trace-hunter/training-lifecycle/0.1-draft"
        },
        "kind": {
          "const": "analysis_request"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "selection"
                  ]
                }
              }
            }
          ]
        },
        "analyzer_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "analyzer"
                  ]
                }
              }
            }
          ]
        },
        "config_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "config"
                  ]
                }
              }
            }
          ]
        },
        "reuse": {
          "enum": [
            "exact",
            "force_new"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "revision",
        "snapshot_ref",
        "analyzer_ref",
        "config_ref",
        "reuse",
        "idempotency_key"
      ],
      "additionalProperties": false
    },
    "replay": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "trace-hunter/training-lifecycle/0.1-draft"
        },
        "kind": {
          "const": "replay"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "source_trace_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "trace"
                  ]
                }
              }
            }
          ]
        },
        "executor_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "executor"
                  ]
                }
              }
            }
          ]
        },
        "mode": {
          "enum": [
            "recorded_tools",
            "reexecute_actions",
            "regenerate"
          ]
        },
        "environment_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/ref"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "environment"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "initial_state_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/ref"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "artifact"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "recording_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/ref"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "artifact"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "model_config_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/ref"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "config"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "blocked",
            "cancelled"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "output_trace_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/ref"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "trace"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "path",
              "message"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "revision",
        "source_trace_ref",
        "executor_ref",
        "mode",
        "environment_ref",
        "initial_state_ref",
        "recording_ref",
        "model_config_ref",
        "state",
        "attempt",
        "output_trace_ref",
        "issues"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "recorded_tools"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "recording_ref": {
                "allOf": [
                  {
                    "$ref": "#/$defs/ref"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "artifact"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "reexecute_actions"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "environment_ref": {
                "allOf": [
                  {
                    "$ref": "#/$defs/ref"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "environment"
                        ]
                      }
                    }
                  }
                ]
              },
              "initial_state_ref": {
                "allOf": [
                  {
                    "$ref": "#/$defs/ref"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "artifact"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "regenerate"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "environment_ref": {
                "allOf": [
                  {
                    "$ref": "#/$defs/ref"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "environment"
                        ]
                      }
                    }
                  }
                ]
              },
              "initial_state_ref": {
                "allOf": [
                  {
                    "$ref": "#/$defs/ref"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "artifact"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "regenerate"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "model_config_ref": {
                "allOf": [
                  {
                    "$ref": "#/$defs/ref"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "config"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "output_trace_ref": {
                "allOf": [
                  {
                    "$ref": "#/$defs/ref"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "trace"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "blocked"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "trace-hunter/training-lifecycle/0.1-draft"
        },
        "kind": {
          "const": "validation"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "replay_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "replay"
                  ]
                }
              }
            }
          ]
        },
        "policy_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "policy"
                  ]
                }
              }
            }
          ]
        },
        "verdict": {
          "enum": [
            "passed",
            "failed",
            "insufficient_data",
            "not_applicable"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "verdict": {
                "enum": [
                  "passed",
                  "failed",
                  "unknown",
                  "not_applicable"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/ref"
                    },
                    {
                      "properties": {
                        "kind": {
                          "enum": [
                            "artifact"
                          ]
                        }
                      }
                    }
                  ]
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "name",
              "verdict",
              "evidence_refs"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "verdict": {
                      "const": "passed"
                    }
                  },
                  "required": [
                    "verdict"
                  ]
                },
                "then": {
                  "properties": {
                    "evidence_refs": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "revision",
        "replay_ref",
        "policy_ref",
        "verdict",
        "checks"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "passed"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "items": {
                  "properties": {
                    "verdict": {
                      "const": "passed"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "dataset": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "trace-hunter/training-lifecycle/0.1-draft"
        },
        "kind": {
          "const": "dataset"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "selection"
                  ]
                }
              }
            }
          ]
        },
        "sample_manifest_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "artifact"
                  ]
                }
              }
            }
          ]
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "transform_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "transform"
                  ]
                }
              }
            }
          ]
        },
        "profile_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "profile"
                  ]
                }
              }
            }
          ]
        },
        "release_policy_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "policy"
                  ]
                }
              }
            }
          ]
        },
        "admission_report_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "artifact"
                  ]
                }
              }
            }
          ]
        },
        "validation_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/ref"
              },
              {
                "properties": {
                  "kind": {
                    "enum": [
                      "validation"
                    ]
                  }
                }
              }
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "analysis_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/ref"
              },
              {
                "properties": {
                  "kind": {
                    "enum": [
                      "artifact"
                    ]
                  }
                }
              }
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "revision",
        "snapshot_ref",
        "sample_manifest_ref",
        "sample_count",
        "transform_ref",
        "profile_ref",
        "release_policy_ref",
        "admission_report_ref",
        "validation_refs",
        "analysis_refs"
      ],
      "additionalProperties": false
    },
    "consumption": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "trace-hunter/training-lifecycle/0.1-draft"
        },
        "kind": {
          "const": "consumption"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "const": 1
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dataset_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "dataset"
                  ]
                }
              }
            }
          ]
        },
        "consumer_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "consumer_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "enum": [
            "delivered",
            "trainer_committed",
            "retracted"
          ]
        },
        "batch_manifest_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "artifact"
                  ]
                }
              }
            }
          ]
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "step_start": {
          "type": "integer",
          "minimum": 0
        },
        "step_end": {
          "type": "integer",
          "minimum": 0
        },
        "commit_evidence_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/ref"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "artifact"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "original_receipt_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/ref"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "consumption"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "revision",
        "receipt_id",
        "dataset_ref",
        "consumer_run_id",
        "consumer_attempt",
        "event",
        "batch_manifest_ref",
        "sample_count",
        "epoch",
        "step_start",
        "step_end",
        "commit_evidence_ref",
        "original_receipt_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "event": {
                "const": "trainer_committed"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "properties": {
              "commit_evidence_ref": {
                "allOf": [
                  {
                    "$ref": "#/$defs/ref"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "artifact"
                        ]
                      }
                    }
                  }
                ]
              },
              "original_receipt_ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "const": "delivered"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "properties": {
              "commit_evidence_ref": {
                "type": "null"
              },
              "original_receipt_ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "const": "retracted"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "properties": {
              "original_receipt_ref": {
                "allOf": [
                  {
                    "$ref": "#/$defs/ref"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "consumption"
                        ]
                      }
                    }
                  }
                ]
              },
              "commit_evidence_ref": {
                "allOf": [
                  {
                    "$ref": "#/$defs/ref"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "artifact"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
